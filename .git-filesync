# git-filesync: files of this repository that are kept in sync with
# files in other repositories. Maintained by 'git filesync'; [file]
# commit/blob and [dir] commit/tree record the upstream version.

# MinHook: license, header and sources (compiled in src/portal_revolution_vr.vcxproj),
# following master
[source "TsudaKageyu/minhook"]
	url = https://github.com/TsudaKageyu/minhook.git
	branch = master
[dir "thirdparty/minhook"]
	source = TsudaKageyu/minhook
	path = /
	include = /LICENSE.txt /include/ /src/
	commit = 8af6b4acae5a9388fd742b56fa79ece89d96f823
	tree = 028369f1763039139784a4366205c2d973bd935e

# Source SDK 2013: license and third-party notices for src/sdk/
[source "ValveSoftware/source-sdk-2013"]
	url = https://github.com/ValveSoftware/source-sdk-2013.git
	branch = master
[file "src/sdk/LICENSE.txt"]
	source = ValveSoftware/source-sdk-2013
	path = LICENSE
	commit = a62efecf624923d3bacc67b8ee4b7f8a9855abfd
	blob = 6e729f1f55af106870bf42a95d8962ffa65abab1
[file "src/sdk/thirdpartylegalnotices.txt"]
	source = ValveSoftware/source-sdk-2013
	path = thirdpartylegalnotices.txt
	commit = 0759e2e8e179d5352d81d0d4aaded72c1704b7a9
	blob = f417b4859d07689761ef2cb13456a0de948a8e13
